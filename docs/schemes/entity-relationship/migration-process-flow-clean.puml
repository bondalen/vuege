@startuml Migration Process Flow

start

:Создание задачи миграции;

:Анализ объектов MS SQL Server;

:Заполнение родительской таблицы;

:Определение типа объекта;

if (Тип объекта?) then (TABLE)
    :Заполнение mssql_tables;
elseif (VIEW) then
    :Заполнение mssql_views;
elseif (FUNCTION) then
    :Заполнение mssql_functions;
elseif (STORED_PROCEDURE) then
    :Заполнение mssql_stored_procedures;
endif

:Выбор объекта для миграции;

:Проверка возможности миграции;

if (Объект можно мигрировать?) then (да)
    :Выполнение миграции;
    :Проверка успешности;
    
    if (Миграция успешна?) then (да)
        :Обновление статуса 'completed';
        :Запись migration_date;
    else (нет)
        :Обновление статуса 'failed';
        :Запись error_message;
    endif
else (нет)
    :Обновление статуса 'skipped';
    :Запись причины пропуска;
endif

:Проверка завершения всех объектов;

if (Все объекты обработаны?) then (нет)
    :Переход к следующему объекту;
    :Обработка следующего объекта;
    :Есть необработанные объекты?;
    if (да) then
        :Возврат к выбору объекта;
    else (нет)
        :Генерация отчета;
        :Анализ результатов;
        stop
    endif
else (да)
    :Генерация отчета;
    :Анализ результатов;
    stop
endif

@enduml