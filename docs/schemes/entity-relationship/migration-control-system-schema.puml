' Связи задач миграции
migration_tasks ||--o{ mssql_data_types : "task_id"
migration_tasks ||--o{ mssql_objects : "task_id"
migration_tasks ||--o{ postgres_objects : "task_id"

' Связи типов данных
mssql_data_types <|-- mssql_base_types : "INHERITS"
mssql_data_types <|-- mssql_derived_types : "INHERITS"
mssql_base_types ||--o{ mssql_derived_types : "base_type_id"

' Связи типов данных PostgreSQL
postgres_data_types <|-- postgres_base_types : "INHERITS"
postgres_data_types <|-- postgres_derived_types : "INHERITS"
postgres_base_types ||--o{ postgres_derived_types : "base_type_id"

' Связи между MS SQL и PostgreSQL типами данных
mssql_data_types ||--o| postgres_data_types : "source_data_type_id"

' Связи MS SQL
mssql_objects <|-- mssql_tables : "INHERITS"
mssql_objects <|-- mssql_views : "INHERITS"
mssql_objects <|-- mssql_functions : "INHERITS"
mssql_objects <|-- mssql_stored_procedures : "INHERITS"
mssql_tables ||--o{ mssql_columns : "table_id"

' Связи PostgreSQL
postgres_objects <|-- postgres_tables : "INHERITS"
postgres_objects <|-- postgres_views : "INHERITS"
postgres_objects <|-- postgres_functions : "INHERITS"
postgres_objects <|-- postgres_stored_procedures : "INHERITS"
postgres_tables ||--o{ postgres_columns : "table_id"

' Связи между MS SQL и PostgreSQL объектами
mssql_tables ||--o| postgres_tables : "source_table_id"
mssql_views ||--o| postgres_views : "source_view_id"
mssql_functions ||--o| postgres_functions : "source_function_id"
mssql_stored_procedures ||--o| postgres_stored_procedures : "source_procedure_id"
mssql_columns ||--o| postgres_columns : "source_column_id"

' Связи колонок с типами данных
mssql_columns }o--|| mssql_data_types : "data_type_id"
postgres_columns }o--|| postgres_data_types : "postgres_data_type_id"

