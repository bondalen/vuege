@startuml Reporting System

!define VIEW(name,desc) class name as "desc" << (V,#AAAAFF) >>

' Представления для отчетности
VIEW(migration_overview, "migration_overview") {
    object_category : VARCHAR(50)
    total_objects : INTEGER
    completed_objects : INTEGER
    failed_objects : INTEGER
    pending_objects : INTEGER
    completion_percentage : DECIMAL(5,2)
}

VIEW(table_migration_details, "table_migration_details") {
    object_name : VARCHAR(255)
    table_size : BIGINT
    row_count : INTEGER
    has_primary_key : BOOLEAN
    has_foreign_keys : BOOLEAN
    migration_status : VARCHAR(50)
    postgres_table_name : VARCHAR(255)
    postgres_row_count : INTEGER
    postgres_table_size : BIGINT
    migration_duration : INTERVAL
    data_integrity_percentage : DECIMAL(5,2)
}

VIEW(view_migration_details, "view_migration_details") {
    object_name : VARCHAR(255)
    is_updatable : BOOLEAN
    check_option : VARCHAR(20)
    definition_complexity : VARCHAR(20)
    dependency_count : INTEGER
    migration_status : VARCHAR(50)
    postgres_view_name : VARCHAR(255)
    migration_duration : INTERVAL
    definition_length_category : VARCHAR(20)
}

VIEW(migration_statistics, "migration_statistics") {
    task_id : INTEGER
    task_description : TEXT
    total_objects : INTEGER
    completed_objects : INTEGER
    failed_objects : INTEGER
    pending_objects : INTEGER
    overall_completion : DECIMAL(5,2)
    total_data_size : BIGINT
    average_migration_time : INTERVAL
}

VIEW(error_summary, "error_summary") {
    error_type : VARCHAR(100)
    error_count : INTEGER
    affected_objects : TEXT[]
    common_causes : TEXT
    suggested_solutions : TEXT
}

' Связи представлений с таблицами
mssql_tables --> table_migration_details : "SELECT"
mssql_views --> view_migration_details : "SELECT"
mssql_objects --> migration_overview : "SELECT"
mssql_objects --> migration_statistics : "SELECT"
mssql_objects --> error_summary : "SELECT"

@enduml